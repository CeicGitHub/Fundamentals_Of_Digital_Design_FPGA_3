/*This file represents a 1-bit adder with carry-in and carry-out, 
	so that it can be used in other sections of our design as an instance.*/
	
module full_adder (
    input wire a,
    input wire b,
    input wire cin,
    output wire sum,
    output wire cout
);
    assign sum = a ^ b ^ cin;
    assign cout = (a & b) | (a & cin) | (b & cin);
	 
	 
endmodule
