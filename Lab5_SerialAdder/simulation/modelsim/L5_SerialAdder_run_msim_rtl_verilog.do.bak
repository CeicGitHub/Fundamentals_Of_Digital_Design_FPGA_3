transcript on
if {[file exists rtl_work]} {
	vdel -lib rtl_work -all
}
vlib rtl_work
vmap work rtl_work

vlog -vlog01compat -work work +incdir+D:/Verilog/Modulo3/Lab5_SerialAdder {D:/Verilog/Modulo3/Lab5_SerialAdder/full_adder.v}
vlog -vlog01compat -work work +incdir+D:/Verilog/Modulo3/Lab5_SerialAdder {D:/Verilog/Modulo3/Lab5_SerialAdder/carry_logic.v}
vlog -vlog01compat -work work +incdir+D:/Verilog/Modulo3/Lab5_SerialAdder {D:/Verilog/Modulo3/Lab5_SerialAdder/input_reg.v}
vlog -vlog01compat -work work +incdir+D:/Verilog/Modulo3/Lab5_SerialAdder {D:/Verilog/Modulo3/Lab5_SerialAdder/output_reg.v}
vlog -vlog01compat -work work +incdir+D:/Verilog/Modulo3/Lab5_SerialAdder {D:/Verilog/Modulo3/Lab5_SerialAdder/counter.v}
vlog -vlog01compat -work work +incdir+D:/Verilog/Modulo3/Lab5_SerialAdder {D:/Verilog/Modulo3/Lab5_SerialAdder/serial_adder_top.v}
vlog -vlog01compat -work work +incdir+D:/Verilog/Modulo3/Lab5_SerialAdder {D:/Verilog/Modulo3/Lab5_SerialAdder/control_fsm.v}

vlog -vlog01compat -work work +incdir+D:/Verilog/Modulo3/Lab5_SerialAdder {D:/Verilog/Modulo3/Lab5_SerialAdder/tb_serial_adder.v}

vsim -t 1ps -L altera_ver -L lpm_ver -L sgate_ver -L altera_mf_ver -L altera_lnsim_ver -L cycloneive_ver -L rtl_work -L work -voptargs="+acc"  tb_serial_adder

add wave *
view structure
view signals
run -all
