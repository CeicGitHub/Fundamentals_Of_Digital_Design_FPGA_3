module bin_to_bcd (
    input [13:0] bin,
    output reg [3:0] bcd_thousands,
    output reg [3:0] bcd_hundreds,
    output reg [3:0] bcd_tens,
    output reg [3:0] bcd_units
);

    integer i;
    reg [27:0] shift;

    always @(*) begin
        shift = 28'd0;
        shift[13:0] = bin;

        for (i = 0; i < 14; i = i + 1) begin
            if (shift[17:14] >= 5)
                shift[17:14] = shift[17:14] + 3;
            if (shift[21:18] >= 5)
                shift[21:18] = shift[21:18] + 3;
            if (shift[25:22] >= 5)
                shift[25:22] = shift[25:22] + 3;
            if (shift[27:26] >= 5)
                shift[27:26] = shift[27:26] + 3;

            shift = shift << 1;
        end

        bcd_thousands = shift[27:24];
        bcd_hundreds  = shift[23:20];
        bcd_tens      = shift[19:16];
        bcd_units     = shift[15:12];
    end

endmodule
